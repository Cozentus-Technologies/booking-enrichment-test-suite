<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.cozentus.enrichment</groupId>
  <artifactId>booking-enrichment-test-suite</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>booking-enrichment-test-suite</name>
  <description>
    Independent black-box BDD test suite for the booking city-enrichment service.
    Verifies behaviour exclusively through the Kafka message contract on
    booking.raw / booking.enriched / booking.flagged and the GET /ready endpoint.
  </description>

  <!--
    ============================================================================
    DELIBERATE ABSENCE: there is no dependency on com.cozentus:city-enrichment
    (the system under test) anywhere in this file, and there must never be one.

    This suite is a *black-box* suite: it knows the service only through its
    external Kafka interface and its published JSON schemas. If a dependency on
    the service artifact is ever added, any test that imports a service class
    will compile, and the black-box boundary becomes a promise instead of a
    fact the build enforces. The absence of that dependency is what makes the
    black-box claim physical rather than promised — see TEST_SUITE_SPEC.md §1.2
    and §2 ("Structural rule enforced by the build").

    Do not add it. If the suite ever needs something from the service, that
    need should be met by a published contract (schema, topic, config value),
    not by a compile-time dependency.
    ============================================================================
  -->

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependency versions, pinned explicitly rather than left to BOM drift. -->
    <junit-bom.version>5.11.3</junit-bom.version>
    <cucumber-bom.version>7.20.1</cucumber-bom.version>
    <junit-platform-suite.version>1.11.3</junit-platform-suite.version>
    <assertj.version>3.26.3</assertj.version>
    <kafka-clients.version>3.9.0</kafka-clients.version>
    <jackson.version>2.18.2</jackson.version>
    <json-schema-validator.version>1.5.4</json-schema-validator.version>
    <allure.version>2.29.0</allure.version>

    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>

    <!-- Bulk/volume run overrides, read by VolumeDataGenerator / VolumeSteps. -->
    <bulk.count>1000</bulk.count>
    <bulk.seed>42</bulk.seed>

    <!-- Which test-config properties file under src/test/resources/config is active. -->
    <suite.env>local</suite.env>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ==================== BDD ==================== -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ==================== JUnit 5 / launcher ==================== -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>${junit-platform-suite.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ==================== Assertions ==================== -->
    <dependency>
      <!-- Spec 8.10: SnakeYAML for the spec/*.yaml inputs. Jackson and the JSON
           schema validator are already present; nothing else is added. -->
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ==================== Kafka client (harness only, see SPEC §3/§4) ==================== -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka-clients.version}</version>
    </dependency>

    <!-- ==================== JSON ==================== -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- ==================== JSON Schema validation (contract layer) ==================== -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ==================== Reporting ==================== -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-cucumber7-jvm</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <plugin>
        <!-- Generates features/functional/city_correction.feature from
             city-cases.csv. Bound to process-test-classes rather than
             generate-test-resources because the generator is itself test code
             and must be compiled first; writing straight into test-classes puts
             the result on the classpath where Cucumber scans for features.

             The generated file is a build output. It is never committed, and
             editing it is pointless because the next build overwrites it.
             Change the CSV. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-city-correction-feature</id>
            <phase>process-test-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.data.FeatureGenerator</mainClass>
              <arguments>
                <argument>${project.build.testOutputDirectory}/features/functional/city_correction.feature</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- F-05: an untagged scenario fails the build. Tags drive selective
                 execution, priority reporting, release gating and traceability;
                 a scenario missing one cannot be sliced, reported or traced.
                 Runs before the tests, so the failure is immediate and cheap. -->
            <id>enforce-tag-discipline</id>
            <phase>process-test-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.support.TagDiscipline</mainClass>
            </configuration>
          </execution>
          <execution>
            <!-- B-4: a flag reason the contract allows and no scenario asserts is a
                 hole the suite cannot see, because a missing scenario does not fail,
                 it is simply absent. Bound before the tests so the gap is reported
                 without waiting for a full run. -->
            <id>guard-flag-reason-coverage</id>
            <phase>process-test-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.support.ReasonCoverage</mainClass>
            </configuration>
          </execution>
          <execution>
            <!-- F-2: the committed traceability matrix claimed to have been derived
                 by scanning the feature files and was thirty-seven cases behind
                 them, with nothing to say so. It is generated now, and this fails
                 the build when the committed copy has drifted from the features. -->
            <id>verify-traceability-matrix</id>
            <phase>process-test-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.docs.TraceabilityMatrix</mainClass>
              <arguments><argument>--check</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <!-- B-5: the suite must not restate the service's confidence floor, or
                 the two agree by construction instead of by test. -->
            <id>guard-against-encoded-thresholds</id>
            <phase>process-test-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.support.ThresholdGuard</mainClass>
            </configuration>
          </execution>
          <execution>
            <!-- A-1: a run that reports success having executed no scenarios is a
                 failure. Bound after the tests so it sees the finished report. -->
            <id>guard-against-empty-runs</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.support.ExecutionGuard</mainClass>
            </configuration>
          </execution>
          <execution>
            <!-- Spec 8.10: the Test Execution Summary Report, generated after the
                 tests have written cucumber.json. Generation must never fail the
                 build, so the generator catches its own errors and the run result
                 stands regardless. -->
            <id>generate-execution-summary-report</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.report.ReportGenerator</mainClass>
            </configuration>
          </execution>
          <execution>
            <!-- D-3: six documents name target/scenario-coverage.md as the release
                 gate and nothing produced it - CoverageReporter was bound to no
                 phase at all. -->
            <id>generate-scenario-coverage</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.support.CoverageReporter</mainClass>
            </configuration>
          </execution>
          <execution>
            <!-- D-3: declared last, so it runs after every report is written.
                 This is what fails the build on a test failure now that surefire
                 does not. -->
            <id>fail-the-build-on-test-failures</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <classpathScope>test</classpathScope>
              <mainClass>com.cozentus.enrichment.tests.report.BuildResultGuard</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- C-1: builds the contract stub into a runnable jar.

             ServiceController launches the service with `java -jar`, and the
             spec requires the stub to be selected purely by -Dservice.jar.path,
             so the stub has to be a jar with its dependencies inside it. That is
             why the stub lives in src/main rather than src/test: shade cannot
             package test classes. It imports nothing from the service, so the
             black-box boundary is unaffected. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>package-contract-stub</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>contract-stub</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.cozentus.enrichment.stub.ContractStub</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <!-- D-3: BuildResultGuard reads what surefire recorded, so surefire's
                 output must describe THIS run and nothing else. Reports are written
                 per test class and never removed, so a filtered run would otherwise
                 leave the previous run's classes behind and the guard would pass or
                 fail on results nobody just produced. -->
            <id>clear-stale-test-reports</id>
            <phase>process-test-classes</phase>
            <goals><goal>clean</goal></goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>target/surefire-reports</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- Cucumber runs through the JUnit Platform engine via
               RunCucumberTest, but the suite also has plain JUnit tests of its
               own helpers - the CSV loader, the feature generator, the schema
               validator. Those test the SUITE, not the service, so they are not
               the white-box unit tests that TEST_SUITE_SPEC section 13 excludes.

               Restricting includes to RunCucumberTest alone silently excluded
               all of them and, while that class did not yet exist, made
               `mvn test` report success having run nothing at all. -->
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <!-- A suite that runs no tests must not report success. -->
          <failIfNoTests>true</failIfNoTests>
          <!-- D-3: surefire aborted the build the instant a test failed, so every
               execution bound after it was skipped - including the Test Execution
               Summary Report and the scenario coverage file. The reports therefore
               existed only for runs that had nothing to report. Surefire now
               records the result without acting on it, the reports are written,
               and BuildResultGuard fails the build afterwards. Same outcome,
               later. -->
          <testFailureIgnore>true</testFailureIgnore>
          <!-- Tests needing a broker are opt-in, so the pure-logic tests of the
               suite's own helpers stay runnable with no Docker. -->
          <excludedGroups>kafka</excludedGroups>
          <!-- RunCucumberTest needs a broker AND a running service; it carries no
               JUnit tag to exclude it by, so it is excluded by name. Without this
               `mvn test` passes on a developer machine that happens to have a
               broker up and fails on a CI runner that does not, which is the
               worst of both. -->
          <excludes>
            <exclude>**/RunCucumberTest.java</exclude>
          </excludes>
          <systemPropertyVariables>
            <suite.env>${suite.env}</suite.env>
            <bulk.count>${bulk.count}</bulk.count>
            <bulk.seed>${bulk.seed}</bulk.seed>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- docker compose up -d in the service repo, then mvn test -Pkafka.
           A-2: also activates automatically whenever a tag filter is supplied.
           Every documented command passes one, and without the profile the whole
           Cucumber suite is excluded, so those commands used to pass in two
           seconds having executed nothing. Auto-activation means the
           documentation cannot drift back into that state. -->
      <id>kafka</id>
      <activation>
        <property><name>cucumber.filter.tags</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"></excludedGroups>
              <excludes combine.self="override"></excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      suite.env selects src/test/resources/config/test-<env>.properties.
      ci activates test-ci.properties; local (the default) uses test-local.properties.
    -->
    <profile>
      <id>ci</id>
      <properties>
        <suite.env>ci</suite.env>
      </properties>
    </profile>

    <!-- Nightly / volume runs: larger bulk.count, no time-budget enforcement. -->
    <profile>
      <id>nightly</id>
      <properties>
        <bulk.count>20000</bulk.count>
      </properties>
    </profile>
  </profiles>

</project>
